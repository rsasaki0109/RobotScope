{
  "name": "robotscope",
  "version": "1.7.0-beta.0",
  "private": true,
  "description": "Open observability platform for ROS2 robots, Autoware, Nav2, MoveIt, and Physical AI",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*",
    "plugins/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@robotscope/viewer",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run demo:fixtures && npm run demo:python && npm run build --workspace=@robotscope/viewer && playwright test",
    "test:python": "npm run build --workspace=@robotscope/core && node scripts/validate-python-recording.mjs",
    "demo:python": "node scripts/create-python-demo.mjs",
    "benchmark:ingest": "npm run build --workspace=@robotscope/core && node scripts/benchmark-ingest.mjs",
    "benchmark:json": "npm run build --workspace=@robotscope/core && node scripts/benchmark-json-ingest.mjs",
    "test:ros2": "docker build -f tests/ros2/Dockerfile -t robotscope-validation:humble . && docker run --rm --network=none robotscope-validation:humble",
    "demo:fixtures": "node scripts/create-tf-demo.mjs packages/robotscope-viewer/public/demo/demo-scene.mcap && node scripts/create-showcase-demo.mjs && node scripts/create-rosbag2-demo.mjs packages/robotscope-viewer/public/demo/demo-rosbag2 && node scripts/create-validation-fixtures.mjs",
    "lint": "npm run lint --workspaces --if-present",
    "demo:autoware": "npm run dev --workspace=@robotscope/viewer -- --open /?layout=autoware",
    "demo:nav2": "npm run dev --workspace=@robotscope/viewer -- --open /?layout=nav2",
    "demo:moveit": "npm run dev --workspace=@robotscope/viewer -- --open /?layout=moveit",
    "demo:timeseries": "npm run dev --workspace=@robotscope/viewer -- --open /?layout=timeseries&demo=1",
    "demo:rosbag2": "node scripts/create-rosbag2-demo.mjs",
    "demo:example": "npm run dev --workspace=@robotscope/viewer -- --open /?layout=example&demo=1",
    "demo:live-agent": "node scripts/live-agent-demo.mjs --allow-publish /cmd_vel --allow-service /robotscope/demo/trigger --allow-set-bool /robotscope/demo/set_bool --allow-action /robotscope/demo/fibonacci",
    "demo:ros2-agent": "bash scripts/run-ros2-agent.sh",
    "demo:ros2-agent:autoware": "bash scripts/run-ros2-agent.sh --profile autoware",
    "build:pages": "node scripts/create-tf-demo.mjs packages/robotscope-viewer/public/demo/demo-scene.mcap && node scripts/create-showcase-demo.mjs && node scripts/create-rosbag2-demo.mjs packages/robotscope-viewer/public/demo/demo-rosbag2 && npm run demo:python && npm run build:pages --workspace=@robotscope/viewer",
    "preview:pages": "npm run preview:pages --workspace=@robotscope/viewer",
    "validate:plugins": "node scripts/validate-plugin-manifests.mjs",
    "convert:rosbag2": "bash scripts/rosbag2-to-mcap.sh",
    "capture:readme-hero": "npm run capture:showcase",
    "capture:showcase": "npm run build:pages && node scripts/capture-showcase.mjs",
    "capture:gallery": "npm run build:pages && node scripts/capture-readme-gallery.mjs",
    "demo:live": "npm run dev --workspace=@robotscope/viewer -- --open /?layout=autoware"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "tsx": "^4.23.1",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=20"
  }
}
